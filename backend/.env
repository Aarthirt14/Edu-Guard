# EduGuard AI — Environment Variables
# Copy to .env and fill in your values

APP_NAME=EduGuard AI
DEBUG=True

HOST=0.0.0.0
PORT=8000

# IMPORTANT: Change this in production
SECRET_KEY=eduguard-secret-key-change-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database — SQLite by default (no setup needed)
DATABASE_URL=sqlite:///./eduguard.db

# Anthropic AI Chat (optional)
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# CORS — add your frontend URL here
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Risk Thresholds
HIGH_RISK_THRESHOLD=70
ATTENDANCE_ALERT_THRESHOLD=60
MARKS_DROP_ALERT_PERCENTAGE=20
